{
  "name": "nova-island",
  "version": "1.4.0",
  "description": "A living island for your Windows desktop",
  "main": "nova.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never",
    "dist:portable": "electron-builder --win portable --publish never",
    "test": "node --test",
    "check:syntax": "node scripts/check-syntax.js"
  },
  "author": "AmerTech",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.17.0"
  },
  "build": {
    "appId": "com.eltawalbeh.island.dev",
    "productName": "Island Dev",
    "copyright": "Copyright © 2026 Nova Island by AmerTech",
    "electronLanguages": [
      "en-US",
      "ar"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "build/icon.png",
      "build/icon.ico",
      "!promo/**",
      "!dist/**",
      "!*.cmd",
      "!setup-log.txt",
      "!**/*.map",
      "!helper/*.cs",
      "!helper/*.cmd"
    ],
    "publish": {
      "provider": "github",
      "owner": "eltawalbeh",
      "repo": "nova-island"
    },
    "asarUnpack": [
      "helper/nova-helper.exe"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "executableName": "Island Dev"
    },
    "nsis": {
      "oneClick": false,
      "artifactName": "Island-Dev-Setup-${version}.${ext}",
      "license": "LICENSE",
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Island Dev",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Island Dev ${version} portable.exe"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "node-ical": "^0.27.3"
  }
}
